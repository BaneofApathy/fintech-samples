---
import Shell from '../../components/layout/Shell.astro';
import Instructor from '../../components/reference/Instructor.svelte';
import { algorithms, exercises, href } from '../../data';

const units = algorithms.map(({ slug, title }) => ({ slug, title }));
const exerciseLabels = Object.fromEntries(
  exercises.map(({ id, title, steps }) => [
    id,
    { title, steps: Object.fromEntries(steps.map((step) => [step.id, step.title])) },
  ]),
);
---

<Shell title="Instructor & progress tools">
  <p class="page-subtitle">
    Present a unit, reveal solutions, review attempts, and import or export progress.
  </p>
  <h2>Prepare the lab</h2>
  <p><a href={href('/instructor/visual-validation/')}>Diagram index and student observation sheet →</a></p>
  <p>
    Give students a runnable example and a defined comparison. Keep a fixed copy of the dataset,
    record random seeds, and pin the Python environment so students can reproduce the results. Check
    the browser example and keep a downloadable notebook available.
  </p>
  <p>
    Ask students to submit baseline results, the effect of one controlled change, and a failure case
    they can explain. Include the code and checks that support their conclusions.
  </p>
  <Instructor algorithms={units} {exerciseLabels} base={import.meta.env.BASE_URL} client:load />
</Shell>
