---
import Shell from '../components/layout/Shell.astro';
import MeasurePicker from '../components/reference/MeasurePicker.svelte';
import { measures, course } from '../data';
---

<Shell title="Choose the right measure">
  <p class="page-subtitle">
    Answer three questions to connect the model’s result with the financial consequence.
  </p>
  <MeasurePicker
    measures={measures}
    evaluation={course.evaluation}
    base={import.meta.env.BASE_URL}
    client:load
  />
</Shell>
