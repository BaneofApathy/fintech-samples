---
import { href } from '../../data';
const current = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '');
const inLibrary = [
  '/library/',
  '/measures/',
  '/measure-picker/',
  '/explorers/',
  '/labs/',
  '/glossary/',
  '/exercises/',
].some((p) => current.startsWith(p));
---

<div class="course-header">
  <button
    class="mobile-menu icon-button"
    aria-label="Open course navigation"
    aria-expanded="false"
    aria-controls="course-navigation"
    id="nav-toggle"
  >
    ☰
  </button>
  <a href={href('/')} class="wordmark" aria-label="Fintech Algorithms course home">
    <span class="brand-icon" aria-hidden="true">
      ƒ
    </span>
    <span>
      Fintech <b>Algorithms</b>
      <small>INSTRUCTOR REFERENCE MATERIAL</small>
    </span>
  </a>
  <nav class="primary-navigation" aria-label="Main navigation">
    <a
      href={href('/')}
      aria-current={
        !inLibrary && !current.startsWith('/progress/') && !current.startsWith('/instructor/')
          ? 'page'
          : undefined
      }
    >
      Learn
    </a>
    <a href={href('/library/')} aria-current={inLibrary ? 'page' : undefined}>
      Library
    </a>
    <a
      href={href('/progress/')}
      aria-current={current.startsWith('/progress/') ? 'page' : undefined}
    >
      My progress
    </a>
  </nav>
  <div class="header-controls">
    <button
      class="search-trigger"
      id="search-open"
      aria-label="Search the course"
      aria-keyshortcuts="/"
    >
      <svg
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        aria-hidden="true"
      >
        <circle cx="10" cy="10" r="6" />
        <path d="m15 15 5 5" />
      </svg>
      <span>Search</span>
      <kbd>/</kbd>
    </button>
    <details class="utility-menu">
      <summary aria-label="Course settings" title="Course settings">
        ⋯
      </summary>
      <div class="utility-content">
        <button id="theme-toggle" aria-label="Switch to dark theme">
          Switch to dark theme
        </button>
        <button id="instructor-toggle" aria-label="Instructor mode" aria-pressed="false">
          Instructor mode <span class="mode-dot" aria-hidden="true"></span>
        </button>
        <a href={href('/instructor/')}>Instructor tools</a>
        <a href={href('/#course-information')}>Course information</a>
      </div>
    </details>
  </div>
</div>
<dialog id="course-search" aria-label="Search the course">
  <div class="search-dialog-head">
    <h2>Search the course</h2>
    <button class="icon-button" id="search-close" aria-label="Close search">
      ×
    </button>
  </div>
  <div id="pagefind-search"></div>
</dialog>
